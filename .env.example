# Copy to .env.local. Everything here is optional — the site runs with none of it.

# The canonical origin, used for metadata, sitemap and robots. Not hard-coded
# because the domain is not owned yet. Vercel sets VERCEL_PROJECT_PRODUCTION_URL
# on production deploys, so a deploy is already correct without this.
# NEXT_PUBLIC_SITE_URL=https://steppal.example

# Waitlist storage. Without these, signups go to an in-memory store that logs
# to the terminal — which is what makes the form work from a fresh clone.
#
# 1. steppal-core: posts to backend API so signups land in shared Postgres
# STEPPAL_CORE_URL=http://localhost:3001
# STEPPAL_CORE_API_KEY=
#
# 2. Resend: posts to Resend audience
# RESEND_API_KEY=
# RESEND_AUDIENCE_ID=

# Changelog releases. By default, /changelog renders curated offline milestone
# snapshots so builds require zero network or credentials. Set to 'true' to pull
# live releases from the GitHub API across steppal-core, steppal-mobile, and steppal-web.
# STEPPAL_FETCH_GITHUB_RELEASES=false
# GITHUB_TOKEN=
